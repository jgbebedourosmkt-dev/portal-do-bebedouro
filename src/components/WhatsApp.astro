---
import { SITE } from '@/lib/site'

const mensagem = 'Olá! Vim pelo Portal do Bebedouro e quero um orçamento.'
const href = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(mensagem)}`
---

<a
  href={href}
  class="whatsapp"
  target="_blank"
  rel="noopener"
  aria-label="Pedir orçamento pelo WhatsApp"
  data-whatsapp
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.08.15.2 2.1 3.2 5.08 4.48.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.75-.71 2-1.4.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.44 9.43m8.03-17.46A11.27 11.27 0 0 0 12.05.72C5.79.72.69 5.81.69 12.08c0 2 .52 3.96 1.52 5.68L.6 23.6l6-1.57a11.33 11.33 0 0 0 5.44 1.38h.01c6.26 0 11.36-5.09 11.36-11.36 0-3.03-1.18-5.89-3.33-8.03"
    ></path>
  </svg>
  <span class="rotulo">
    <strong>Orçamento no WhatsApp</strong>
    <small>Resposta rápida, sem compromisso</small>
  </span>
</a>

<script>
  document.querySelector('[data-whatsapp]')?.addEventListener('click', () => {
    (window as { gtag?: (...a: unknown[]) => void }).gtag?.('event', 'whatsapp_click', { page_path: location.pathname })
  })
</script>

<style>
  .whatsapp {
    position: fixed;
    right: var(--sp-5);
    bottom: var(--sp-5);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-5) var(--sp-2) var(--sp-2);
    background: var(--c-acento);
    color: var(--c-sobre-acento);
    border-radius: 999px;
    box-shadow: 0 6px 24px color-mix(in srgb, var(--tinta-900) 28%, transparent);
    font-family: var(--ff-ui);
    text-decoration: none;
    transition:
      background var(--dur),
      transform var(--dur) var(--ease);
    animation: entrar 400ms var(--ease) 1.2s backwards;
  }
  /* Onda que se espalha a partir do botão, de tempos em tempos */
  .whatsapp::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--c-acento);
    animation: onda 3s var(--ease) 2s infinite;
  }
  .whatsapp:hover {
    background: var(--c-acento-hover);
    transform: translateY(-2px);
  }
  .whatsapp:hover::after {
    animation: none;
  }
  .whatsapp:focus-visible {
    outline: 2px solid var(--c-foco);
    outline-offset: 3px;
  }
  svg {
    flex: none;
    width: 44px;
    height: 44px;
    padding: var(--sp-2);
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-sobre-acento) 16%, transparent);
    animation: balancar 3s ease-in-out 2s infinite;
  }
  .whatsapp:hover svg {
    animation-play-state: paused;
  }
  .rotulo {
    display: grid;
    line-height: 1.2;
  }
  strong {
    font-size: var(--fs-ui);
    font-weight: 650;
  }
  small {
    font-size: var(--fs-micro);
    opacity: 0.8;
  }
  @keyframes entrar {
    from {
      opacity: 0;
      transform: translateY(var(--sp-4));
    }
  }
  @keyframes onda {
    0% {
      opacity: 0.55;
      transform: scale(1);
    }
    60%,
    100% {
      opacity: 0;
      transform: scale(1.15, 1.45);
    }
  }
  @keyframes balancar {
    0%,
    70%,
    100% {
      transform: rotate(0);
    }
    75% {
      transform: rotate(-14deg);
    }
    80% {
      transform: rotate(12deg);
    }
    85% {
      transform: rotate(-8deg);
    }
    90% {
      transform: rotate(4deg);
    }
  }
  /* No celular fica só a chamada curta, para cobrir menos texto */
  @media (max-width: 640px) {
    .whatsapp {
      right: var(--sp-4);
      bottom: var(--sp-4);
      padding-right: var(--sp-4);
    }
    small {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp,
    .whatsapp::after,
    svg {
      animation: none;
      transition: none;
    }
  }
</style>
