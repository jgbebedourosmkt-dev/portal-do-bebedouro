    font-size: var(--fs-h3);
    margin-bottom: var(--sp-5);
  }
  form {
    display: grid;
    gap: var(--sp-5);
  }
  form[hidden] {
    display: none;
  }
  .linha {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }
  label {
    display: grid;
    gap: var(--sp-2);
  }
  label span {
    font-size: var(--fs-micro);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-texto-3);
  }
  input,
  textarea {
    padding: var(--sp-3);
    background: var(--c-superficie);
    border: var(--filete) solid var(--c-filete);
    border-radius: var(--raio);
    font-family: var(--ff-texto);
    font-size: 1.0625rem;
    resize: vertical;
    transition: border-color var(--dur);
  }
  input:focus,
  textarea:focus {
    outline: 0;
    border-color: var(--c-acento);
  }
  .acoes {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4);
  }
  button {
    flex-shrink: 0;
    padding: var(--sp-3) var(--sp-5);
    background: var(--c-texto);
    color: var(--c-fundo);
    border: 0;
    border-radius: var(--raio);
    font-weight: 650;
    cursor: pointer;
    transition: background var(--dur);
  }
  button:hover {
    background: var(--c-acento);
  }
  .ok {
    padding: var(--sp-5);
    border-left: 3px solid var(--c-ok);
    background: var(--c-superficie);
  }
  .ok .titulo {
    font-size: var(--fs-h4);
