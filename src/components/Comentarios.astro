<section class="comentarios" aria-labelledby="com-titulo">
  <h2 id="com-titulo" class="titulo">Deixe seu comentário</h2>
  <form data-comentario>
    <div class="linha">
      <label>
        <span>Nome</span>
        <input type="text" name="nome" required autocomplete="name" />
      </label>
      <label>
        <span>E-mail</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
    </div>
    <label>
      <span>Comentário</span>
      <textarea name="comentario" rows="5" required></textarea>
    </label>
    <div class="acoes">
      <p class="meta">Seu e-mail não será publicado. Comentários passam por moderação.</p>
      <button type="submit">Enviar comentário</button>
    </div>
  </form>
  <div class="ok" hidden>
    <p class="titulo">Comentário enviado.</p>
    <p>Obrigado pela participação. Ele aparece aqui depois da moderação.</p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-comentario]')
  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    // TODO: enviar para um backend de comentários
    form.hidden = true
    form.nextElementSibling?.removeAttribute('hidden')
  })
</script>

<style>
  .comentarios {
