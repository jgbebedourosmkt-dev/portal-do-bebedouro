---
import type { CollectionEntry } from 'astro:content'
import Base from '@/layouts/Base.astro'
import Faq from '@/components/Faq.astro'
import CtaOrcamento from '@/components/CtaOrcamento.astro'

interface Props {
  pilar: CollectionEntry<'pilares'>
}
const { pilar } = Astro.props
const d = pilar.data
---

<Base title={d.metaTitle} description={d.metaDescription} noindex={d.noIndex} schemas={d.schemas}>
  <header class="hero">
    <div class="container hero-interno">
      <nav class="trilha" aria-label="Trilha">
        <a href="/">Início</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{d.breadcrumbLabel}</span>
      </nav>
      <p class="kicker surgir">{d.badge}</p>
      <h1 class="manchete surgir" style="--i:1">{d.title}</h1>
      <p class="linha-fina surgir" style="--i:2">{d.excerpt}</p>
      <button type="button" class="cta surgir" style="--i:3" data-orcamento>
        Pedir orçamento grátis <span aria-hidden="true">→</span>
      </button>
    </div>
  </header>

  <div class="container corpo">
    <main class="texto">
      <div class="prosa" set:html={d.html} />

      {
        d.internalLinks.length > 0 && (
          <nav class="leia" aria-labelledby="leia-titulo">
            <h2 id="leia-titulo">Leia também</h2>
            <ul>
              {d.internalLinks.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <Faq itens={d.faqs} />
      <CtaOrcamento titulo={d.finalCtaTitle} descricao={d.finalCtaDesc} />
    </main>

    <aside class="lateral">
      <div class="fixa">
        {
          d.tocItems.length > 0 && (
            <nav class="bloco" aria-labelledby="toc-titulo">
              <h2 id="toc-titulo" class="bloco-titulo">Neste guia</h2>
              <ol class="toc">
                {d.tocItems.map((t) => (
                  <li>
                    <a href={t.href}>{t.label}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {
          d.stats.length > 0 && (
            <section class="bloco">
              <h2 class="bloco-titulo">Em números</h2>
              <dl class="numeros">
                {d.stats.map((s) => (
                  <div>
                    <dd>{s.valor}</dd>
                    <dt>{s.label}</dt>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <section class="bloco pedido">
          <p class="titulo">Precisa de orçamento?</p>
          <p>Atendimento em todo o Brasil.</p>
          <button type="button" data-orcamento>Orçamento grátis</button>
        </section>
      </div>
    </aside>
  </div>
</Base>

<style>
  .hero {
    padding-block: var(--sp-6) var(--sp-7);
    border-bottom: 2px solid var(--c-filete-forte);
  }
  .hero-interno > * {
    max-width: 58rem;
  }
  .trilha {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-bottom: var(--sp-5);
    font-size: var(--fs-meta);
    color: var(--c-texto-3);
  }
  .trilha a:hover {
    color: var(--c-acento);
  }
  .manchete {
    margin-top: var(--sp-3);
    font-size: var(--fs-h1);
  }
  .linha-fina {
    margin-top: var(--sp-4);
    max-width: 42rem;
    font-family: var(--ff-texto);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    font-style: italic;
    line-height: 1.5;
    color: var(--c-texto-2);
  }
  .cta {
    margin-top: var(--sp-5);
    padding: var(--sp-3) var(--sp-5);
    background: var(--c-acento);
    color: var(--c-sobre-acento);
    border: 0;
    border-radius: var(--raio);
    font-weight: 650;
    cursor: pointer;
    transition: background var(--dur);
  }
  .cta:hover {
    background: var(--c-acento-hover);
  }

  .corpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--lateral);
    gap: var(--sp-8);
    margin-top: var(--sp-7);
  }
  .texto {
    max-width: 46rem;
  }

  .leia {
    margin-top: var(--sp-8);
    padding: var(--sp-5);
    background: var(--c-superficie);
    border: var(--filete) solid var(--c-filete);
    border-radius: var(--raio);
  }
  .leia h2 {
    font-size: var(--fs-micro);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .leia ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    padding: 0;
    list-style: none;
  }
  .leia a {
    display: inline-block;
    padding: var(--sp-1) var(--sp-3);
    border: var(--filete) solid var(--c-filete);
    border-radius: 999px;
    font-size: var(--fs-meta);
    color: var(--c-texto-2);
    transition: border-color var(--dur), color var(--dur);
  }
  .leia a::first-letter {
    text-transform: uppercase;
  }
  .leia a:hover {
    border-color: var(--c-acento);
    color: var(--c-acento);
  }

  /* Lateral */
  .fixa {
    position: sticky;
    top: 5rem;
    display: grid;
    gap: var(--sp-6);
  }
  .bloco-titulo {
    padding-top: var(--sp-2);
    margin-bottom: var(--sp-3);
    border-top: 2px solid var(--c-filete-forte);
    font-family: var(--ff-ui);
    font-size: var(--fs-micro);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .toc {
    counter-reset: toc;
    list-style: none;
    padding: 0;
  }
  .toc a {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    padding-block: var(--sp-2);
    border-bottom: var(--filete) solid var(--c-filete);
    font-size: var(--fs-ui);
    line-height: 1.35;
    color: var(--c-texto-2);
    transition: color var(--dur);
  }
  .toc a::before {
    counter-increment: toc;
    content: counter(toc, decimal-leading-zero);
    font-family: var(--ff-display);
    font-style: italic;
    color: var(--c-acento);
  }
  .toc a:hover {
    color: var(--c-acento);
  }
  .numeros {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4) var(--sp-3);
  }
  .numeros dd {
    margin: 0;
    font-family: var(--ff-display);
    font-size: var(--fs-h4);
    line-height: 1.1;
    color: var(--c-acento);
  }
  .numeros dt {
    margin-top: var(--sp-1);
    font-size: var(--fs-meta);
    line-height: 1.3;
    color: var(--c-texto-3);
  }
  .numeros div {
    display: flex;
    flex-direction: column;
  }
  .pedido {
    padding: var(--sp-5);
    background: var(--c-invertido);
    color: var(--c-sobre-invertido);
    border-radius: var(--raio);
  }
  .pedido .titulo {
    font-size: var(--fs-h4);
  }
  .pedido p:not(.titulo) {
    margin-top: var(--sp-1);
    font-size: var(--fs-meta);
    opacity: 0.7;
  }
  .pedido button {
    width: 100%;
    margin-top: var(--sp-4);
    padding: var(--sp-3);
    background: var(--c-sobre-invertido);
    color: var(--c-invertido);
    border: 0;
    border-radius: var(--raio);
    font-weight: 650;
    cursor: pointer;
    transition: background var(--dur);
  }
  .pedido button:hover {
    background: var(--cobalto-300);
  }

  @media (max-width: 1024px) {
    .corpo {
      grid-template-columns: 1fr;
    }
    .texto {
      max-width: none;
    }
    .lateral {
      display: none;
    }
  }
</style>
