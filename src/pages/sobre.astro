---
import { getEntry } from 'astro:content'
import PaginaTexto from '@/components/PaginaTexto.astro'

const pagina = await getEntry('paginas', 'sobre')
---

<PaginaTexto
  title={pagina?.data.title ?? 'Sobre'}
  description="Conheça o Portal do Bebedouro, a referência do setor de bebedouros e purificadores de água no Brasil."
  html={pagina?.data.content}
/>
